#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_MOVE_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <31 33 32>;
        };

        /*
         * Windows -> Linux
         *
         * DELETE + BACKSLASH + SINGLE_QUOTE
         */
        windows_to_linux {
            bindings = <&to 6>;
            key-positions = <11 23 35>;
            layers = <0>;
            timeout-ms = <100>;
        };

        /*
         * Linux -> Windows
         *
         * DELETE + BACKSLASH + SINGLE_QUOTE
         */
        linux_to_windows {
            bindings = <&to 0>;
            key-positions = <11 23 35>;
            layers = <6>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ============================================================
         * L0 - WINDOWS BASE
         * ============================================================
         */
        default_layer {
            bindings = <
                &kp ESC          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp DELETE
                &kp TAB          &kp Q         &kp W         &kp E         &kp R         &kp T            &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BACKSLASH
                &kp LSHFT        &kp A         &kp S         &kp D         &kp F         &kp G            &kp H         &kp J         &kp K         &kp L         &kp SEMICOLON &mt RSHFT SINGLE_QUOTE
                &kp LCTRL        &kp Z         &kp X         &kp C         &kp V         &kp B            &kp N         &kp M         &kp COMMA     &kp PERIOD    &mt RSHFT SLASH &mo 4
                &mo 2            &mo 1         &kp BACKSPACE &kp SPACE      &mo 3         &mo 5
            >;
        };

        /*
         * ============================================================
         * L1 - WINDOWS
         * Mouse / Navigation / Multimedia
         * ============================================================
         */
        L1 {
            bindings = <
                &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans          &trans          &trans          &trans        &trans        &kp C_PREV       &kp C_PLAY_PAUSE  &kp C_NEXT       &kp C_VOL_DN   &kp C_VOLUME_UP
                &kp INS               &trans                &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP    &trans        &kp PAGE_UP   &kp HOME         &kp UP_ARROW      &kp END         &kp PAGE_DOWN  &trans
                &trans                &trans                &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans        &trans        &kp LEFT_ARROW   &kp DOWN_ARROW    &kp RIGHT       &trans         &trans
                &kp LEFT_COMMAND      &trans                &trans          &trans          &trans          &trans        &trans        &trans           &trans             &trans         &trans         &trans
                &trans                &mo 1                 &kp LEFT_ALT    &mkp LCLK       &mkp RCLK        &mkp MCLK
            >;
        };

        /*
         * ============================================================
         * L2 - WINDOWS
         * Symbols / Navigation
         * ============================================================
         */
        L2 {
            bindings = <
                &trans          &trans  &trans          &trans          &trans        &trans    &trans          &trans        &trans       &kp MINUS  &kp EQUAL  &trans
                &kp GRAVE       &trans  &trans          &kp UP_ARROW    &trans        &trans    &trans          &trans        &trans       &kp LBKT   &kp RBKT   &trans
                &kp LEFT_SHIFT  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &trans    &trans          &trans        &trans       &trans     &trans     &trans
                &kp LCTRL       &trans  &trans          &trans          &trans        &trans    &trans          &trans        &trans       &trans     &trans     &trans
                &mo 2           &kp CAPSLOCK &trans    &kp LEFT_COMMAND &kp LEFT_ALT &trans
            >;
        };

        /*
         * ============================================================
         * L3 - WINDOWS
         * F1-F12
         * ============================================================
         */
        L3 {
            bindings = <
                &kp F1            &kp F2  &kp F3  &kp F4  &kp F5  &kp F6       &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
                &kp TAB           &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans   &trans   &trans
                &kp LEFT_SHIFT    &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans   &trans   &trans
                &kp LEFT_CONTROL  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &bt BT_PRV &bt BT_NXT &bt BT_CLR
                &kp ESCAPE        &kp LEFT_ALT &kp LEFT_COMMAND &trans &mo 3 &trans
            >;
        };

        /*
         * ============================================================
         * L4 - WINDOWS
         * Special characters
         * ============================================================
         */
        L4 {
            bindings = <
                &trans          &kp RA(NUMBER_1) &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                &kp CAPSLOCK    &trans           &trans &kp RA(E) &trans &trans  &trans &kp RA(U) &kp RA(I) &kp RA(O) &trans &trans
                &trans          &kp RA(A)        &trans &trans &trans &trans     &trans &trans &trans &trans &trans &trans
                &trans          &trans           &trans &trans &trans &trans     &kp RA(N) &trans &trans &trans &kp RA(SLASH) &mo 4
                &trans          &kp LEFT_ALT     &kp LEFT_COMMAND &kp SPACE &trans &trans
            >;
        };

        /*
         * ============================================================
         * L5 - WINDOWS
         * Numpad
         * ============================================================
         */
        L5 {
            bindings = <
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &kp N7 &kp N8 &kp N9
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &kp N4 &kp N5 &kp N6
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &kp N1 &kp N2 &kp N3
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &kp NUMBER_0 &trans
                &trans &trans &kp LEFT_COMMAND &trans &trans &mo 5
            >;
        };

        /*
         * ============================================================
         * L6 - LINUX BASE
         * ============================================================
         *
         * MO7  = Mouse
         * MO8  = Navigation / Symbols
         * MO9  = F-keys + Multimedia + Brightness + Volume
         * MO10 = Special characters
         * MO11 = Super / Hyprland modifiers
         */
        L6 {
            bindings = <
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &mo 10
                &mo 8 &mo 7 &kp BACKSPACE &kp SPACE &mo 9 &kp LEFT_COMMAND
            >;
        };

        /*
         * ============================================================
         * L7 - LINUX
         * Mouse / Scroll / Clicks
         *
         * Igual que Windows L1, pero SIN:
         * - Brillo
         * - Volumen
         * - Multimedia
         */
        L7 {
            bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans        &trans        &trans          &trans          &trans          &trans         &trans
                &kp INS         &trans          &msc SCRL_DOWN &mmv MOVE_UP    &msc SCRL_UP    &trans        &kp PAGE_UP   &kp HOME        &kp UP_ARROW    &kp END         &kp PAGE_DOWN  &trans
                &trans          &trans          &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans        &trans        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT       &trans         &trans
                &kp LEFT_COMMAND &trans         &trans          &trans          &trans          &trans        &trans        &trans          &trans          &trans          &trans         &trans
                &trans          &mo 7           &kp LEFT_ALT    &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };

        /*
         * ============================================================
         * L8 - LINUX
         * Navigation / Symbols
         *
         * Igual que Windows L2.
         *
         * Incluye:
         * - Flechas
         * - Home / End
         * - Page Up / Page Down
         * - Grave
         * - -
         * - =
         * - [
         * - ]
         * - Shift / Ctrl / Alt
         *
         * NO incluye:
         * - Brillo
         * - Volumen
         * - Multimedia
         */
        L8 {
            bindings = <
                &trans          &trans  &trans          &trans          &trans        &trans    &trans          &trans        &trans       &kp MINUS  &kp EQUAL  &trans
                &kp GRAVE       &trans  &trans          &kp UP_ARROW    &trans        &trans    &trans          &trans        &trans       &kp LBKT   &kp RBKT   &trans
                &kp LEFT_SHIFT  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &trans    &trans          &trans        &trans       &trans     &trans     &trans
                &kp LCTRL       &trans  &trans          &trans          &trans        &trans    &trans          &trans        &trans       &trans     &trans     &trans
                &mo 8           &kp CAPSLOCK &trans    &kp LEFT_COMMAND &kp LEFT_ALT &trans
            >;
        };

        /*
         * ============================================================
         * L9 - LINUX
         * F1-F12 + Multimedia + Brightness + Volume
         * ============================================================
         *
         * Acá se concentra todo el control del sistema.
         */
        L9 {
            bindings = <
                &kp F1            &kp F2  &kp F3  &kp F4  &kp F5  &kp F6       &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
                &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &trans &trans &trans &trans       &trans &kp C_PREV &kp C_PLAY_PAUSE &kp C_NEXT &kp C_VOL_DN &kp C_VOLUME_UP
                &trans          &trans  &trans  &trans  &trans  &trans       &trans &trans &trans &trans &trans &trans
                &trans          &trans  &trans  &trans  &trans  &trans       &trans &trans &trans &trans &trans &trans
                &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        /*
         * ============================================================
         * L10 - LINUX
         * Special characters
         *
         * Igual que Windows L4.
         */
        L10 {
            bindings = <
                &trans          &kp RA(NUMBER_1) &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                &kp CAPSLOCK    &trans           &trans &kp RA(E) &trans &trans  &trans &kp RA(U) &kp RA(I) &kp RA(O) &trans &trans
                &trans          &kp RA(A)        &trans &trans &trans &trans     &trans &trans &trans &trans &trans &trans
                &trans          &trans           &trans &trans &trans &trans     &kp RA(N) &trans &trans &trans &kp RA(SLASH) &trans
                &trans          &kp LEFT_ALT     &kp LEFT_COMMAND &kp SPACE &trans &trans
            >;
        };

        /*
         * ============================================================
         * L11 - LINUX
         * SUPER / HYPRLAND
         * ============================================================
         *
         * La posición física de CTRL se convierte en SUPER.
         *
         * El resto de las teclas es TRANSPARENTE.
         *
         * Esto permite combinar físicamente:
         *
         * L11 + CTRL físico + SPACE
         *     -> SUPER + SPACE
         *
         * L11 + CTRL físico + SHIFT + SPACE
         *     -> SUPER + SHIFT + SPACE
         *
         * L11 + CTRL físico + ALT + SPACE
         *     -> SUPER + ALT + SPACE
         *
         * L11 + CTRL físico + 1
         *     -> SUPER + 1
         *
         * L11 + CTRL físico + SHIFT + 1
         *     -> SUPER + SHIFT + 1
         *
         * L11 + CTRL físico + TAB
         *     -> SUPER + TAB
         *
         * Recomendados para Hyprland / Noctalia:
         *
         * SUPER + SPACE
         *     Launcher
         *
         * SUPER + S
         *     Control Center
         *
         * SUPER + Q
         *     Cerrar ventana
         *
         * SUPER + F
         *     Fullscreen
         *
         * SUPER + V
         *     Toggle floating
         *
         * SUPER + 1..9
         *     Workspace
         *
         * SUPER + SHIFT + 1..9
         *     Mover ventana al workspace
         *
         * SUPER + TAB
         *     Cambiar ventana
         *
         * SUPER + SHIFT + S
         *     Screenshot
         *
         * SUPER + SHIFT + R
         *     Recargar configuración
         */
        L11 {
            bindings = <
                &trans          &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                &trans          &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                &trans          &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                &kp LEFT_COMMAND &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans &trans
                &trans          &trans &trans &trans &trans &trans
            >;
        };
    };
};
